{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/about\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/certificates\\/create\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/certificates\\/detail\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/certificates\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/login\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/blog\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/certificate\\/verify\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/certificate\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/contact\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/portfolio\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/analisis-bitcoin-q1-2026\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/belajar-candlestick\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/posts\\/cara-pakai-metamask\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/tools\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}