---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Certificate Detail — Akim Certificate" description="Detail certificate dari Sepolia blockchain.">
  <div class="detail-wrap">
    <div class="container">

      <header class="page-head">
        <a href="/admin/certificates" class="back-link">← All Certificates</a>
        <p class="page-label">Certificate Detail</p>
        <h1 id="cert-title">Loading...</h1>
        <div id="cert-status-badge"></div>
      </header>

      <div id="detail-content">
        <div class="loading-state">
          <div class="spinner"></div>
          <p>Reading certificate from Sepolia...</p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .detail-wrap { padding: var(--space-8) 0 var(--space-16); }

  .page-head {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }
  .back-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }
  .back-link:hover { color: var(--accent); }
  .page-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
  .page-head h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    font-family: var(--font-mono);
  }

  .status-badge {
    display: inline-block;
    font-size: 0.75rem;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .status-badge.valid {
    background: rgba(16, 185, 129, 0.1);
    color: var(--positive);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .status-badge.revoked {
    background: rgba(239, 68, 68, 0.1);
    color: var(--negative);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .loading-state {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-12) 0;
    color: var(--text-tertiary);
    font-size: 0.875rem;
    justify-content: center;
  }
  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .error-box {
    padding: var(--space-6);
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-left: 3px solid var(--negative);
    border-radius: var(--radius-md);
  }
  .error-box h3 {
    color: var(--negative);
    font-size: 1rem;
    margin-bottom: var(--space-3);
  }
  .error-box p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  /* Section */
  .section {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .section-title {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Info rows */
  .info-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.875rem;
    align-items: start;
  }
  .info-row:last-child { border-bottom: none; padding-bottom: 0; }
  .info-row:first-child { padding-top: 0; }

  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    font-weight: 600;
    padding-top: 2px;
  }
  .info-value {
    color: var(--text-primary);
    word-break: break-all;
    line-height: 1.5;
  }
  .info-value.mono {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* QR */
  .qr-section {
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .qr-image-wrap {
    background: white;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .qr-image-wrap canvas,
  .qr-image-wrap img {
    display: block;
  }
  .qr-info {
    flex: 1;
    min-width: 240px;
  }
  .qr-caption {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    word-break: break-all;
    line-height: 1.6;
  }
  .qr-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* Danger */
  .danger-zone {
    padding: var(--space-5);
    background: rgba(239, 68, 68, 0.04);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }
  .danger-zone h3 {
    font-size: 0.9375rem;
    color: var(--negative);
    margin-bottom: var(--space-2);
  }
  .danger-zone p {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .btn-danger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.625rem 1.125rem;
    background: rgba(239, 68, 68, 0.1);
    color: var(--negative);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-danger:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.5);
  }
  .btn-danger:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .result-box {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    margin-top: var(--space-4);
  }
  .result-box.success {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  .result-box.error {
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }
  .result-box h3 {
    font-size: 0.9375rem;
    margin-bottom: var(--space-2);
  }
  .result-box.success h3 { color: var(--positive); }
  .result-box.error h3 { color: var(--negative); }
  .result-box p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .page-head h1 { font-size: 1.25rem; }
    .info-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .qr-section {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script>
  import { BLOCKCHAIN_CONFIG, getProvider, CERTIFICATE_ABI } from '../../../lib/blockchain';
  import { ethers } from 'ethers';
  import QRCode from 'qrcode';

  // Auth guard
  const wallet = localStorage.getItem('admin_wallet');
  if (!wallet) {
    window.location.href = '/admin/login';
  }

  // Ambil certificate ID dari query string
  const params = new URLSearchParams(window.location.search);
  const certificateId = params.get('id') || '';

  const titleEl = document.getElementById('cert-title');
  const badgeEl = document.getElementById('cert-status-badge');
  const contentEl = document.getElementById('detail-content');

  // ============================================
  // LOAD CERTIFICATE
  // ============================================
  async function loadDetail() {
    if (!contentEl) return;

    if (!certificateId) {
      contentEl.innerHTML = renderError('Certificate ID tidak valid.');
      return;
    }

    if (titleEl) titleEl.textContent = certificateId;

    try {
      const provider = getProvider();
      const contract = new ethers.Contract(
        BLOCKCHAIN_CONFIG.contractAddress,
        CERTIFICATE_ABI,
        provider
      );

      const result = await contract.verifyCertificate(certificateId);

      if (!result || !result.exists) {
        contentEl.innerHTML = renderError(
          `Certificate dengan ID "${certificateId}" tidak ditemukan di blockchain.`
        );
        return;
      }

      const data = {
        certificateId: result.certificateId,
        recipientName: result.recipientName,
        certificateType: result.certificateType,
        issuer: result.issuer,
        issuedAt: Number(result.issuedAt),
        certificateHash: result.certificateHash,
        revoked: result.revoked,
        exists: result.exists,
      };

      if (badgeEl) {
        const statusClass = data.revoked ? 'revoked' : 'valid';
        const statusText = data.revoked ? 'Revoked' : 'Valid';
        badgeEl.innerHTML = `<span class="status-badge ${statusClass}">${statusText}</span>`;
      }

      contentEl.innerHTML = renderDetail(data);

      const verifyUrl = `https://certificate.akim.web.id/certificate/verify?id=${data.certificateId}`;
      await generateQR(verifyUrl);

      bindRevoke(data);

    } catch (err: any) {
      contentEl.innerHTML = renderError(
        `Gagal baca blockchain: ${err.message || 'Unknown error.'}`
      );
    }
  }

  // ============================================
  // RENDER DETAIL
  // ============================================
  function renderDetail(data: any) {
    const issuedDate = new Date(data.issuedAt * 1000).toLocaleString('id-ID', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });

    const verifyUrl = `https://certificate.akim.web.id/certificate/verify?id=${data.certificateId}`;

    return `
      <section class="section">
        <div class="section-title">Certificate Information</div>
        <div class="info-row">
          <span class="info-label">Certificate ID</span>
          <span class="info-value mono">${escape(data.certificateId)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Recipient</span>
          <span class="info-value">${escape(data.recipientName)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Certificate Type</span>
          <span class="info-value">${escape(data.certificateType)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Issuer</span>
          <span class="info-value">${escape(data.issuer)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Issued At</span>
          <span class="info-value">${issuedDate}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Status</span>
          <span class="info-value">${data.revoked ? 'Revoked' : 'Valid'}</span>
        </div>
      </section>

      <section class="section">
        <div class="section-title">Blockchain Record</div>
        <div class="info-row">
          <span class="info-label">Network</span>
          <span class="info-value mono">${escape(BLOCKCHAIN_CONFIG.network)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Contract Address</span>
          <span class="info-value mono">${escape(BLOCKCHAIN_CONFIG.contractAddress)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Certificate Hash</span>
          <span class="info-value mono">${escape(data.certificateHash)}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Verification URL</span>
          <span class="info-value mono">${escape(verifyUrl)}</span>
        </div>
      </section>

      <section class="section">
        <div class="section-title">QR Code</div>
        <div class="qr-section">
          <div class="qr-image-wrap">
            <canvas id="qr-canvas"></canvas>
          </div>
          <div class="qr-info">
            <div class="qr-caption">${escape(verifyUrl)}</div>
            <div class="qr-actions">
              <a href="${verifyUrl}" target="_blank" rel="noopener" class="btn">Open Verification Page</a>
              <button class="btn-secondary" id="download-qr-btn">Download QR</button>
            </div>
          </div>
        </div>
      </section>

      ${
        !data.revoked
          ? `
        <div class="danger-zone">
          <h3>⚠ Danger Zone</h3>
          <p>
            Revoke certificate akan mengubah statusnya menjadi <strong>REVOKED</strong> di blockchain.
            Tindakan ini <strong>permanen</strong> dan tidak bisa dibatalkan.
          </p>
          <button class="btn-danger" id="revoke-btn">Revoke Certificate</button>
        </div>
      `
          : `
        <div class="danger-zone" style="background: rgba(245,158,11,0.04); border-color: rgba(245,158,11,0.2);">
          <h3 style="color: var(--warning);">Certificate Revoked</h3>
          <p>Certificate ini sudah dicabut. Status permanen di blockchain.</p>
        </div>
      `
      }
    `;
  }

  // ============================================
  // GENERATE QR
  // ============================================
  async function generateQR(text: string) {
    const canvas = document.getElementById('qr-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    try {
      await QRCode.toCanvas(canvas, text, {
        width: 200,
        margin: 2,
        color: { dark: '#000000', light: '#ffffff' },
      });
    } catch (e) {
      console.warn('QR generation failed:', e);
    }

    const downloadBtn = document.getElementById('download-qr-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        const url = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = url;
        a.download = `${certificateId}-qr.png`;
        a.click();
      });
    }
  }

  // ============================================
  // REVOKE
  // ============================================
  function bindRevoke(data: any) {
    const btn = document.getElementById('revoke-btn') as HTMLButtonElement;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      if (!confirm(`Yakin mau revoke certificate "${data.certificateId}"?\n\nTindakan ini permanen.`)) {
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Waiting for MetaMask...';

      try {
        const provider = new ethers.BrowserProvider((window as any).ethereum);
        const signer = await provider.getSigner();
        const contract = new ethers.Contract(
          BLOCKCHAIN_CONFIG.contractAddress,
          CERTIFICATE_ABI,
          signer
        );

        const tx = await contract.revokeCertificate(data.certificateId);
        const receipt = await tx.wait();

        const resultSlot = document.createElement('div');
        resultSlot.className = 'result-box success';
        resultSlot.innerHTML = `
          <h3>✓ Certificate Revoked</h3>
          <p>
            Certificate <strong>${escape(data.certificateId)}</strong> berhasil dicabut.
            Tx Hash: <code>${receipt.hash}</code>
          </p>
        `;
        btn.parentElement?.appendChild(resultSlot);

        setTimeout(() => location.reload(), 2000);
      } catch (err: any) {
        btn.disabled = false;
        btn.textContent = 'Revoke Certificate';

        const resultSlot = document.createElement('div');
        resultSlot.className = 'result-box error';
        resultSlot.innerHTML = `
          <h3>✗ Gagal Revoke</h3>
          <p>${escape(err.message || 'Transaction failed.')}</p>
        `;
        btn.parentElement?.appendChild(resultSlot);
      }
    });
  }

  // ============================================
  // HELPERS
  // ============================================
  function renderError(message: string) {
    return `
      <div class="error-box">
        <h3>⚠ Error</h3>
        <p>${escape(message)}</p>
        <a href="/admin/certificates" class="btn-secondary">← Back to List</a>
      </div>
    `;
  }

  function escape(str: string) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Init
  loadDetail();
</script>