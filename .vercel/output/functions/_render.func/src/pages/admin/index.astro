---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Dashboard — Akim Certificate" description="Admin panel untuk digital certificate blockchain.">
  <div class="dashboard-wrap">
    <div class="container">

      <header class="dash-header">
        <div>
          <p class="dash-label">Dashboard</p>
          <h1>Certificate Dashboard</h1>
          <p class="dash-sub">Manage digital certificates and blockchain verification.</p>
        </div>
        <button class="btn-secondary" id="logout-btn">Disconnect</button>
      </header>

      <section class="blockchain-status" id="blockchain-status">
        <div class="status-header">
          <div class="status-dot status-checking"></div>
          <div>
            <strong>Checking blockchain status...</strong>
          </div>
        </div>
      </section>

      <section class="stats-grid">
        <div class="stat-card">
          <span class="stat-label">Total Certificates</span>
          <span class="stat-value" id="stat-total">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Valid Certificates</span>
          <span class="stat-value positive" id="stat-valid">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Revoked</span>
          <span class="stat-value negative" id="stat-revoked">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Blockchain Records</span>
          <span class="stat-value" id="stat-records">—</span>
        </div>
      </section>

      <section class="actions-row">
        <a href="/admin/certificates/create" class="btn">Create Certificate →</a>
        <a href="/admin/certificates" class="btn-secondary">View All Certificates</a>
      </section>

      <section class="recent-section">
        <header class="section-head">
          <h2>Recent Certificates</h2>
          <a href="/admin/certificates" class="section-link">View all →</a>
        </header>

        <div id="recent-certificates">
          <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading certificates from blockchain...</p>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .dashboard-wrap { padding: var(--space-8) 0 var(--space-16); }

  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }
  .dash-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
  .dash-header h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: var(--space-1);
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .dash-sub {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .blockchain-status {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .status-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.status-checking {
    background: var(--text-tertiary);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .status-dot.status-online { background: var(--positive); }
  .status-dot.status-offline { background: var(--negative); }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .status-header strong {
    color: var(--text-primary);
    font-size: 0.9375rem;
    display: block;
  }
  .status-header small {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 2px;
    font-family: var(--font-mono);
  }
  .status-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }
  .status-item { display: flex; flex-direction: column; gap: 2px; }
  .status-item-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
  }
  .status-item-value {
    font-size: 0.8125rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    word-break: break-all;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .stat-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .stat-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
  }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .stat-value.positive { color: var(--positive); }
  .stat-value.negative { color: var(--negative); }

  .actions-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-5);
  }
  .section-head h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .section-link { font-size: 0.8125rem; color: var(--text-tertiary); }
  .section-link:hover { color: var(--accent); }

  .loading-state {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) 0;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }
  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .empty-state {
    padding: var(--space-12) 0;
    text-align: center;
    color: var(--text-tertiary);
  }
  .empty-state strong {
    display: block;
    color: var(--text-primary);
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }
  .empty-state p { font-size: 0.875rem; margin-bottom: var(--space-4); }

  .cert-list { display: flex; flex-direction: column; border-top: 1px solid var(--border-subtle); }
  .cert-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.875rem;
    align-items: center;
  }
  .cert-id {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text-primary);
  }
  .cert-name { color: var(--text-secondary); }
  .cert-type { color: var(--text-tertiary); font-size: 0.8125rem; }
  .cert-status {
    font-size: 0.6875rem;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    justify-self: start;
  }
  .cert-status.valid {
    background: rgba(16, 185, 129, 0.1);
    color: var(--positive);
  }
  .cert-status.revoked {
    background: rgba(239, 68, 68, 0.1);
    color: var(--negative);
  }

  @media (max-width: 900px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .status-details { grid-template-columns: 1fr; }
    .cert-row { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .dash-header { flex-direction: column; align-items: stretch; }
    .stats-grid { grid-template-columns: 1fr; }
    .cert-row { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>

<script>
  import { BLOCKCHAIN_CONFIG, getProvider, CERTIFICATE_ABI } from '../../lib/blockchain';
  import { ethers } from 'ethers';

  // ============================================
  // AUTH GUARD
  // ============================================
  const wallet = localStorage.getItem('admin_wallet');
  if (!wallet) {
    window.location.href = '/admin/login';
  }

  // ============================================
  // DISCONNECT
  // ============================================
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('admin_wallet');
      localStorage.removeItem('admin_connected_at');
      window.location.href = '/admin/login';
    });
  }

  // ============================================
  // BLOCK DEPLOY CONTRACT
  // ============================================
  const DEPLOY_BLOCK = 11728000;

  // ============================================
  // LOAD BLOCKCHAIN STATUS
  // ============================================
  async function loadBlockchainStatus() {
    const el = document.getElementById('blockchain-status');
    if (!el) return;

    try {
      const provider = getProvider();
      const blockNumber = await provider.getBlockNumber();

      el.innerHTML = `
        <div class="status-header">
          <div class="status-dot status-online"></div>
          <div>
            <strong>Blockchain Connected</strong>
            <small>Latest block: #${blockNumber}</small>
          </div>
        </div>
        <div class="status-details">
          <div class="status-item">
            <span class="status-item-label">Network</span>
            <span class="status-item-value">${BLOCKCHAIN_CONFIG.network}</span>
          </div>
          <div class="status-item">
            <span class="status-item-label">Chain ID</span>
            <span class="status-item-value">${BLOCKCHAIN_CONFIG.chainId}</span>
          </div>
          <div class="status-item">
            <span class="status-item-label">Contract</span>
            <span class="status-item-value">${BLOCKCHAIN_CONFIG.contractAddress}</span>
          </div>
          <div class="status-item">
            <span class="status-item-label">Connected Wallet</span>
            <span class="status-item-value">${wallet}</span>
          </div>
        </div>
      `;
    } catch (err) {
      el.innerHTML = `
        <div class="status-header">
          <div class="status-dot status-offline"></div>
          <div>
            <strong>Blockchain Offline</strong>
            <small>Unable to connect to Sepolia network.</small>
          </div>
        </div>
      `;
    }
  }

  // ============================================
  // QUERY EVENT — chunked
  // ============================================
  async function queryAllEvents(contract, filter) {
    const provider = contract.runner?.provider;
    if (!provider) return [];

    const latest = await provider.getBlockNumber();
    const CHUNK = 9999;
    const allEvents = [];

    for (let from = DEPLOY_BLOCK; from <= latest; from += CHUNK) {
      const to = Math.min(from + CHUNK - 1, latest);
      try {
        const events = await contract.queryFilter(filter, from, to);
        allEvents.push(...events);
      } catch (e) {
        console.warn(`Skip chunk ${from}-${to}:`, e.message);
      }
    }

    return allEvents;
  }

  // ============================================
  // DECODE CERT ID FROM TX
  // ============================================
  async function decodeCertId(provider, txHash) {
    try {
      const tx = await provider.getTransaction(txHash);
      if (!tx || !tx.data) return '—';

      const iface = new ethers.Interface(CERTIFICATE_ABI);
      const decoded = iface.parseTransaction({ data: tx.data });

      if (decoded && decoded.args && decoded.args.length > 0) {
        return decoded.args[0];
      }
      return '—';
    } catch (e) {
      console.warn('Failed to decode certId:', e);
      return '—';
    }
  }

  // ============================================
  // LOAD CERTIFICATES
  // ============================================
  async function loadCertificates() {
    const el = document.getElementById('recent-certificates');
    if (!el) return;

    try {
      const provider = getProvider();
      const contract = new ethers.Contract(
        BLOCKCHAIN_CONFIG.contractAddress,
        CERTIFICATE_ABI,
        provider
      );

      const filter = contract.filters.CertificateIssued();
      const events = await queryAllEvents(contract, filter);

      const total = events.length;

      // Update stats
      const statTotal = document.getElementById('stat-total');
      const statValid = document.getElementById('stat-valid');
      const statRevoked = document.getElementById('stat-revoked');
      const statRecords = document.getElementById('stat-records');

      if (statTotal) statTotal.textContent = total.toString();
      if (statValid) statValid.textContent = total.toString();
      if (statRevoked) statRevoked.textContent = '0';
      if (statRecords) statRecords.textContent = total.toString();

      if (total === 0) {
        el.innerHTML = `
          <div class="empty-state">
            <strong>No certificates yet</strong>
            <p>Create your first digital certificate.</p>
            <a href="/admin/certificates/create" class="btn">Create Certificate →</a>
          </div>
        `;
        return;
      }

      // Tampilkan 5 terbaru
      const recent = events.slice(-5).reverse();

      let html = '<div class="cert-list">';
      for (const ev of recent) {
        const args = ev.args;
        const name = args[1];
        const type = args[2];

        // Decode certId dari tx input
        const certId = await decodeCertId(provider, ev.transactionHash);

        html += `
          <div class="cert-row">
            <span class="cert-id">${certId}</span>
            <span class="cert-name">${name}</span>
            <span class="cert-type">${type}</span>
            <span class="cert-status valid">VALID</span>
          </div>
        `;
      }
      html += '</div>';
      el.innerHTML = html;

    } catch (err) {
      el.innerHTML = `
        <div class="empty-state">
          <strong>Unable to load certificates</strong>
          <p>${err.message || 'Please check your connection to Sepolia.'}</p>
          <button class="btn-secondary" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  // Init
  loadBlockchainStatus();
  loadCertificates();
</script>