---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tools — Akim" description="Kalkulator kecil buat ngitung trading dan crypto. Bukan saran beli/jual.">
  <div class="container">
    <header class="page-header">
      <p class="page-label">Tools</p>
      <h1>Kalkulator kecil</h1>
      <p class="page-lead">
        Beberapa kalkulator yang gue bikin buat ngulik trading dan crypto.
        Jalan di HP atau laptop lu, ga dikirim ke mana-mana.
      </p>
      <p class="disclaimer">
        <strong>Catatan:</strong> Ini cuma alat hitung, bukan saran beli/jual.
        Keputusan tetap di lu.
      </p>
    </header>

    <!-- ============================================ -->
    <!-- KALKULATOR RISIKO (NEW) -->
    <!-- ============================================ -->
    <section class="tool-card tool-card-full">
      <header class="tool-head">
        <h2>Kalkulator Risiko</h2>
        <p>
          Hitung ukuran posisi berdasarkan modal, risiko, dan jarak SL.
          Bedain antara <em>unit</em> (oz, coin) dan <em>lot</em> (broker).
        </p>
      </header>

      <div class="tool-body">
        <!-- ===== BASIC ===== -->
        <div class="form-grid">
          <label>
            <span>Modal (USD)</span>
            <input type="number" id="rc-modal" placeholder="60" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Risiko per transaksi (%)</span>
            <input type="number" id="rc-risk" placeholder="5" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Instrumen</span>
            <select id="rc-instrument">
              <option value="XAUUSD">XAUUSD (Gold)</option>
              <option value="FOREX">Forex (Standard)</option>
              <option value="CRYPTO">Crypto (Spot)</option>
              <option value="CUSTOM">Custom</option>
            </select>
          </label>
          <label>
            <span>Arah posisi</span>
            <select id="rc-direction">
              <option value="BUY">BUY</option>
              <option value="SELL">SELL</option>
            </select>
          </label>
          <label>
            <span>Harga masuk (entry)</span>
            <input type="number" id="rc-entry" placeholder="4325" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Batas kerugian (stop loss)</span>
            <input type="number" id="rc-sl" placeholder="4315" step="any" inputmode="decimal" />
          </label>
        </div>

        <div class="advanced-toggle">
          <button type="button" class="btn-ghost" id="rc-toggle-advanced">
            ▼ Advanced
          </button>
        </div>

        <div class="form-grid advanced-fields" id="rc-advanced" hidden>
          <label>
            <span>Contract Size (per lot)</span>
            <input type="number" id="rc-contract" placeholder="100" step="any" inputmode="decimal" value="100" />
            <small>Default: 100 oz/lot (XAUUSD)</small>
          </label>
          <label>
            <span>Minimum Lot (broker)</span>
            <input type="number" id="rc-min-lot" placeholder="0.01" step="any" inputmode="decimal" value="0.01" />
          </label>
          <label>
            <span>Lot Step</span>
            <input type="number" id="rc-lot-step" placeholder="0.01" step="any" inputmode="decimal" value="0.01" />
          </label>
          <label>
            <span>Take Profit (opsional)</span>
            <input type="number" id="rc-tp" placeholder="4345" step="any" inputmode="decimal" />
          </label>
        </div>

        <button class="btn" data-calc="risk">Hitung</button>
      </div>

      <div class="result-panel" id="rc-result" hidden></div>
    </section>

    <!-- ============================================ -->
    <!-- KALKULATOR LAIN (SIMPLE) -->
    <!-- ============================================ -->
    <div class="tools-grid">

      <!-- P/L -->
      <section class="tool-card">
        <header class="tool-head">
          <h2>Kalkulator Untung / Rugi</h2>
          <p>Hitung untung atau rugi dari posisi yang lagi lu pegang.</p>
        </header>
        <div class="tool-body">
          <label>
            <span>Harga masuk (entry)</span>
            <input type="number" id="pl-entry" placeholder="50000" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Harga keluar (exit)</span>
            <input type="number" id="pl-exit" placeholder="52000" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Jumlah yang dibeli</span>
            <input type="number" id="pl-size" placeholder="0.1" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Arah posisi</span>
            <select id="pl-side">
              <option value="long">Beli (long)</option>
              <option value="short">Jual (short)</option>
            </select>
          </label>
          <button class="btn" data-calc="pl">Hitung</button>
        </div>
        <div class="tool-result" id="pl-result" hidden></div>
      </section>

      <!-- CRYPTO -->
      <section class="tool-card">
        <header class="tool-head">
          <h2>Kalkulator Crypto</h2>
          <p>Ubah jumlah crypto ke USD atau Rupiah. Harga lu isi sendiri ya.</p>
        </header>
        <div class="tool-body">
          <label>
            <span>Jumlah crypto</span>
            <input type="number" id="cc-amount" placeholder="0.5" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Harga per koin (USD)</span>
            <input type="number" id="cc-price" placeholder="78000" step="any" inputmode="decimal" />
          </label>
          <label>
            <span>Kurs USD ke Rupiah</span>
            <input type="number" id="cc-rate" placeholder="15800" step="any" inputmode="decimal" value="15800" />
          </label>
          <button class="btn" data-calc="crypto">Hitung</button>
        </div>
        <div class="tool-result" id="cc-result" hidden></div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
    max-width: 640px;
  }
  .page-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }
  .page-header h1 { font-size: 2.25rem; margin-bottom: var(--space-3); }
  .page-lead {
    font-size: 1.0625rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
    line-height: 1.7;
  }
  .disclaimer {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    background: var(--bg-elevated);
    border-left: 3px solid var(--warning);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    margin: 0;
  }
  .disclaimer strong { color: var(--warning); }

  .tool-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: border-color 0.15s ease;
    margin-bottom: var(--space-6);
  }
  .tool-card-full { max-width: 100%; }
  .tool-card:hover { border-color: var(--border-default); }

  .tool-head h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 var(--space-1) 0;
    color: var(--text-primary);
  }
  .tool-head p {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-6) 0;
    line-height: 1.5;
  }
  .tool-head em {
    color: var(--text-secondary);
    font-style: italic;
  }

  .tool-body { display: flex; flex-direction: column; gap: var(--space-4); }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-4);
  }

  .tool-body label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .tool-body label span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    font-weight: 500;
  }
  .tool-body label small {
    font-size: 0.6875rem;
    color: var(--text-quaternary);
    margin-top: 2px;
  }

  .tool-body input,
  .tool-body select {
    background: var(--bg-base);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.15s ease;
    width: 100%;
  }
  .tool-body input:focus,
  .tool-body select:focus { border-color: var(--accent); }
  .tool-body input::placeholder { color: var(--text-quaternary); }

  .tool-body .btn {
    margin-top: var(--space-2);
    justify-content: center;
    width: 100%;
  }

  .advanced-toggle {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }
  .btn-ghost {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    font-family: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s ease;
  }
  .btn-ghost:hover { color: var(--accent); }

  /* ============ RESULT PANEL ============ */
  .result-panel {
    margin-top: var(--space-6);
    padding: var(--space-6);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .result-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
  }
  .result-grid-3 { grid-template-columns: repeat(3, 1fr); }

  .result-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .result-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 500;
  }
  .result-value {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .result-value-sm {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .result-value.positive { color: var(--positive); }
  .result-value.negative { color: var(--negative); }
  .result-value.warning { color: var(--warning); }

  .result-note {
    font-size: 0.75rem;
    color: var(--text-quaternary);
    font-family: var(--font-mono);
  }

  .result-divider {
    border-top: 1px solid var(--border-subtle);
    margin: var(--space-4) 0;
    padding-top: var(--space-4);
  }

  .result-warning {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-left: 3px solid var(--warning);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .result-warning strong { color: var(--warning); }
  .result-warning ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0 0;
  }
  .result-warning li {
    padding: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .result-error {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-left: 3px solid var(--negative);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-size: 0.875rem;
    color: var(--negative);
  }

  .result-section-title {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .broker-check {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-top: var(--space-4);
  }
  .broker-check-title {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .broker-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2) 0;
    font-size: 0.8125rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .broker-row:last-child { border-bottom: none; }
  .broker-row-label { color: var(--text-tertiary); }
  .broker-row-value {
    font-family: var(--font-mono);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  /* ============ RESPONSIVE ============ */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .tools-grid { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .result-grid, .result-grid-3 { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .tool-card { padding: var(--space-4); }
    .result-value { font-size: 0.9375rem; }
  }
</style>

<script>
  // ============================================
  // RISK CALCULATOR — Client Logic (plain JS)
  // ============================================

  const INSTRUMENT_PRESETS = {
    XAUUSD: { contractSize: 100, unit: 'oz', minimumLot: 0.01, lotStep: 0.01 },
    FOREX:  { contractSize: 100000, unit: 'unit', minimumLot: 0.01, lotStep: 0.01 },
    CRYPTO: { contractSize: 1, unit: 'coin', minimumLot: 0.00001, lotStep: 0.00001 },
    CUSTOM: { contractSize: 1, unit: 'unit', minimumLot: 0.01, lotStep: 0.01 },
  };

  function fmt(n, decimals = 2) {
    if (!isFinite(n)) return '—';
    return n.toLocaleString('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
  }

  function calcRisk() {
    const balance     = parseFloat(document.getElementById('rc-modal').value);
    const riskPercent = parseFloat(document.getElementById('rc-risk').value);
    const entry       = parseFloat(document.getElementById('rc-entry').value);
    const stopLoss    = parseFloat(document.getElementById('rc-sl').value);
    const direction   = document.getElementById('rc-direction').value;
    const instrumentKey = document.getElementById('rc-instrument').value;

    const contractSize = parseFloat(document.getElementById('rc-contract').value);
    const minimumLot   = parseFloat(document.getElementById('rc-min-lot').value);
    const lotStep      = parseFloat(document.getElementById('rc-lot-step').value);
    const takeProfitRaw = document.getElementById('rc-tp').value;
    const takeProfit   = takeProfitRaw ? parseFloat(takeProfitRaw) : null;

    const preset = INSTRUMENT_PRESETS[instrumentKey] || INSTRUMENT_PRESETS.CUSTOM;

    // ---- Validasi ----
    if (!isFinite(balance) || balance <= 0) return showError('Modal harus lebih dari 0.');
    if (!isFinite(riskPercent) || riskPercent <= 0 || riskPercent > 100) return showError('Risiko harus antara 0 dan 100 persen.');
    if (!isFinite(entry) || entry <= 0) return showError('Harga entry harus lebih dari 0.');
    if (!isFinite(stopLoss) || stopLoss <= 0) return showError('Stop loss harus lebih dari 0.');
    if (direction === 'BUY' && stopLoss >= entry) return showError('Stop Loss tidak valid untuk posisi BUY. SL harus di bawah entry.');
    if (direction === 'SELL' && stopLoss <= entry) return showError('Stop Loss tidak valid untuk posisi SELL. SL harus di atas entry.');
    if (takeProfit != null && isFinite(takeProfit) && takeProfit > 0) {
      if (direction === 'BUY' && takeProfit <= entry) return showError('Take Profit tidak valid untuk posisi BUY. TP harus di atas entry.');
      if (direction === 'SELL' && takeProfit >= entry) return showError('Take Profit tidak valid untuk posisi SELL. TP harus di bawah entry.');
    }
    if (!isFinite(contractSize) || contractSize <= 0) return showError('Contract size harus lebih dari 0.');

    // ---- Hitung ----
    const riskAmount    = balance * (riskPercent / 100);
    const slDistance    = Math.abs(entry - stopLoss);
    const slPercent     = (slDistance / entry) * 100;
    const positionUnits = riskAmount / slDistance;
    const positionLots  = positionUnits / contractSize;
    const notionalValue = positionUnits * entry;

    // ---- Take profit ----
    let tpDistance = null, rewardAmount = null, riskReward = null;
    if (takeProfit != null && isFinite(takeProfit) && takeProfit > 0) {
      tpDistance = Math.abs(takeProfit - entry);
      rewardAmount = positionUnits * tpDistance;
      riskReward = tpDistance / slDistance;
    }

    // ---- Broker check ----
    let theoreticalBelowMinimum = false;
    let actualRiskAtMinLot = null;
    let actualRiskExceedsTarget = false;

    if (minimumLot > 0 && positionLots < minimumLot) {
      theoreticalBelowMinimum = true;
      actualRiskAtMinLot = minimumLot * contractSize * slDistance;
      actualRiskExceedsTarget = actualRiskAtMinLot > riskAmount;
    }

    // ---- Render ----
    const resultEl = document.getElementById('rc-result');
    const unitLabel = preset.unit;
    const lotsDecimals = 5;

    let html = '';

    // Risk + SL
    html += `<div class="result-section-title">Hasil Perhitungan</div>`;
    html += `<div class="result-grid">`;
    html += `  <div class="result-item">
                <span class="result-label">Duit yang siap dirugiin</span>
                <span class="result-value">$${fmt(riskAmount)}</span>
               </div>`;
    html += `  <div class="result-item">
                <span class="result-label">Jarak ke stop loss</span>
                <span class="result-value">${fmt(slDistance)}</span>
                <span class="result-note">${fmt(slPercent, 2)}% dari entry</span>
               </div>`;
    html += `  <div class="result-item">
                <span class="result-label">Ukuran posisi (unit)</span>
                <span class="result-value">${fmt(positionUnits, 4)} ${unitLabel}</span>
               </div>`;
    html += `  <div class="result-item">
                <span class="result-label">Ukuran posisi (lot)</span>
                <span class="result-value">${fmt(positionLots, lotsDecimals)} lot</span>
                <span class="result-note">1 lot = ${fmt(contractSize, 0)} ${unitLabel}</span>
               </div>`;
    html += `  <div class="result-item">
                <span class="result-label">Nilai nominal posisi</span>
                <span class="result-value">$${fmt(notionalValue)}</span>
               </div>`;
    html += `</div>`;

    // Take profit
    if (riskReward != null) {
      html += `<div class="result-divider"></div>`;
      html += `<div class="result-section-title">Risk : Reward</div>`;
      html += `<div class="result-grid">`;
      html += `  <div class="result-item">
                  <span class="result-label">Risk : Reward</span>
                  <span class="result-value">1 : ${fmt(riskReward, 2)}</span>
                 </div>`;
      html += `  <div class="result-item">
                  <span class="result-label">Potensi rugi (estimasi)</span>
                  <span class="result-value negative">$${fmt(riskAmount)}</span>
                 </div>`;
      html += `  <div class="result-item">
                  <span class="result-label">Potensi profit (estimasi)</span>
                  <span class="result-value positive">$${fmt(rewardAmount)}</span>
                 </div>`;
      html += `</div>`;
      html += `<p class="result-note" style="margin-top:8px;">Estimasi berdasarkan input. Bukan jaminan profit.</p>`;
    }

    // Broker check
    if (minimumLot > 0) {
      html += `<div class="broker-check">`;
      html += `  <div class="broker-check-title">Broker Check</div>`;
      html += `  <div class="broker-row">
                  <span class="broker-row-label">Minimum lot</span>
                  <span class="broker-row-value">${minimumLot}</span>
                 </div>`;
      html += `  <div class="broker-row">
                  <span class="broker-row-label">Lot step</span>
                  <span class="broker-row-value">${lotStep}</span>
                 </div>`;
      html += `  <div class="broker-row">
                  <span class="broker-row-label">Ukuran teoritis</span>
                  <span class="broker-row-value">${fmt(positionLots, lotsDecimals)} lot</span>
                 </div>`;
      if (theoreticalBelowMinimum) {
        html += `  <div class="broker-row">
                    <span class="broker-row-label">Status</span>
                    <span class="broker-row-value warning">⚠️ Di bawah minimum broker</span>
                   </div>`;
      } else {
        html += `  <div class="broker-row">
                    <span class="broker-row-label">Status</span>
                    <span class="broker-row-value positive">✓ Valid</span>
                   </div>`;
      }
      html += `</div>`;
    }

    // Warning: theoretical < minimum
    if (theoreticalBelowMinimum) {
      html += `<div class="result-warning">`;
      html += `  <strong>⚠️ Perhatian:</strong> Ukuran teoritis <strong>${fmt(positionLots, lotsDecimals)} lot</strong> di bawah minimum broker <strong>${minimumLot} lot</strong>.`;
      html += `  <ul>`;
      html += `    <li>Target risiko: <strong>$${fmt(riskAmount)}</strong></li>`;
      html += `    <li>Risiko pada ${minimumLot} lot: <strong>$${fmt(actualRiskAtMinLot)}</strong></li>`;
      if (actualRiskExceedsTarget) {
        html += `    <li>Status: <strong style="color: var(--negative);">⚠️ Melebihi batas risiko</strong></li>`;
      }
      html += `  </ul>`;
      html += `  <p style="margin-top:8px;">Jangan bulatkan ke bawah. Kalo lu pakai ${minimumLot} lot, risiko lu lebih besar dari target. Sesuaikan modal atau perlebar jarak SL.</p>`;
      html += `</div>`;
    }

    // Disclaimer
    html += `<p class="result-note" style="margin-top:16px;">
              Contract size dapat berbeda tergantung broker. Periksa spesifikasi simbol di broker lu.
             </p>`;

    resultEl.innerHTML = html;
    resultEl.hidden = false;
  }

  function showError(msg) {
    const el = document.getElementById('rc-result');
    el.innerHTML = `<div class="result-error">${msg}</div>`;
    el.hidden = false;
  }

  // ============================================
  // AUTO-FILL INSTRUMENT PRESET
  // ============================================
  document.getElementById('rc-instrument').addEventListener('change', (e) => {
    const preset = INSTRUMENT_PRESETS[e.target.value];
    if (!preset) return;
    document.getElementById('rc-contract').value = preset.contractSize;
    document.getElementById('rc-min-lot').value = preset.minimumLot;
    document.getElementById('rc-lot-step').value = preset.lotStep;
  });

  // ============================================
  // ADVANCED TOGGLE
  // ============================================
  const advBtn = document.getElementById('rc-toggle-advanced');
  const advFields = document.getElementById('rc-advanced');
  advBtn.addEventListener('click', () => {
    const isHidden = advFields.hidden;
    advFields.hidden = !isHidden;
    advBtn.textContent = isHidden ? '▲ Sembunyikan advanced' : '▼ Advanced';
  });

  // ============================================
  // P/L CALCULATOR (simple)
  // ============================================
  function calcPL() {
    const entry = parseFloat(document.getElementById('pl-entry').value);
    const exit  = parseFloat(document.getElementById('pl-exit').value);
    const size  = parseFloat(document.getElementById('pl-size').value);
    const side  = document.getElementById('pl-side').value;

    if ([entry, exit, size].some((v) => !isFinite(v) || v <= 0)) {
      return showSimple('pl-result', '<span class="warning">Isi semua kolom dengan angka yang bener ya.</span>');
    }
    const diff = side === 'long' ? exit - entry : entry - exit;
    const pl = diff * size;
    const pct = (diff / entry) * 100;
    const cls = pl >= 0 ? 'positive' : 'negative';
    const sign = pl >= 0 ? '+' : '';
    const label = pl >= 0 ? 'Untung' : 'Rugi';

    showSimple('pl-result', `
      <div><strong>Arah:</strong> ${side === 'long' ? 'Beli (long)' : 'Jual (short)'}</div>
      <div><strong>Selisih harga:</strong> ${fmt(diff)}</div>
      <div class="${cls}"><strong>${label}:</strong> ${sign}$${fmt(pl)} (${sign}${fmt(pct)}%)</div>
    `);
  }

  function calcCrypto() {
    const amount = parseFloat(document.getElementById('cc-amount').value);
    const price  = parseFloat(document.getElementById('cc-price').value);
    const rate   = parseFloat(document.getElementById('cc-rate').value);

    if ([amount, price, rate].some((v) => !isFinite(v) || v <= 0)) {
      return showSimple('cc-result', '<span class="warning">Isi semua kolom dengan angka yang bener ya.</span>');
    }
    const usd = amount * price;
    const idr = usd * rate;

    showSimple('cc-result', `
      <div><strong>Dalam USD:</strong> $${fmt(usd)}</div>
      <div><strong>Dalam Rupiah:</strong> Rp ${fmt(idr, 0)}</div>
    `);
  }

  function showSimple(id, html) {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = html;
    el.hidden = false;
  }

  // ============================================
  // BINDINGS
  // ============================================
  const handlers = {
    risk: calcRisk,
    pl: calcPL,
    crypto: calcCrypto,
  };

  document.querySelectorAll('[data-calc]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.calc;
      if (key && handlers[key]) handlers[key]();
    });
  });
</script>