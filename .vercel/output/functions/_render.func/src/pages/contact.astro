---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socials } from '../data/socials';

const contacts = [
  { label: 'Email', value: socials.email, href: `mailto:${socials.email}` },
  { label: 'Instagram', value: `@${socials.instagram.handle}`, href: socials.instagram.url },
  { label: 'Telegram', value: `@${socials.telegram.handle}`, href: socials.telegram.url },
  { label: 'GitHub', value: socials.github.username, href: socials.github.url },
];
---

<BaseLayout title="Kontak — Akim">
  <div class="container">
    <header class="page-header">
      <p class="page-label">Kontak</p>
      <h1>Hubungi gue</h1>
      <p class="page-lead">
        Kalau mau ngobrol soal project, teknologi, atau sekadar tukar ide, boleh kontak gue.
      </p>
    </header>

    <ul class="contact-list">
      {contacts.map((c) => (
        <li>
          <a
            href={c.href}
            target={c.href.startsWith('mailto') ? undefined : '_blank'}
            rel={c.href.startsWith('mailto') ? undefined : 'noopener'}
          >
            <span class="contact-label">{c.label}</span>
            <span class="contact-value">{c.value}</span>
            <span class="contact-arrow">→</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="note">
      <p>
        Gue cek email dan DM tiap hari. Kalo urgent, Telegram paling cepet.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
  }
  .page-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }
  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }
  .page-lead {
    font-size: 1.0625rem;
    color: var(--text-tertiary);
    margin: 0;
    max-width: 560px;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-12) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .contact-list li {
    border-bottom: 1px solid var(--border-subtle);
  }
  .contact-list a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
    transition: padding 0.15s ease;
  }
  .contact-list a:hover {
    padding-left: var(--space-3);
  }
  .contact-list a:hover .contact-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  .contact-list a:hover .contact-value {
    color: var(--accent);
  }

  .contact-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    min-width: 90px;
  }
  .contact-value {
    flex: 1;
    font-size: 0.9375rem;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }
  .contact-arrow {
    color: var(--text-quaternary);
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .note {
    max-width: 560px;
  }
  .note p {
    color: var(--text-tertiary);
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 640px) {
    .contact-label {
      min-width: 70px;
      font-size: 0.75rem;
    }
    .contact-value {
      font-size: 0.875rem;
      word-break: break-all;
    }
  }
</style>