---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Create Certificate — Akim Certificate" description="Issue certificate baru di Sepolia blockchain.">
  <div class="create-wrap">
    <div class="container">

      <header class="page-head">
        <div>
          <a href="/admin" class="back-link">← Dashboard</a>
          <p class="page-label">Admin</p>
          <h1>Create Certificate</h1>
          <p class="page-sub">
            Issue a new digital certificate on Sepolia Testnet.
          </p>
        </div>
      </header>

      <section class="wallet-status" id="wallet-status">
        <div class="status-dot status-checking"></div>
        <div>
          <strong>Checking wallet...</strong>
        </div>
      </section>

      <form class="create-form" id="create-form">
        <div class="form-grid">
          <label>
            <span>Certificate ID</span>
            <input
              type="text"
              id="cert-id"
              placeholder="CERT-2026-XXXXXX"
              autocomplete="off"
              spellcheck="false"
              required
              readonly
            />
            <small>ID auto-generated. Klik 🔄 untuk regenerate.</small>
            <button type="button" id="regenerate-id" class="btn-regen">🔄 Regenerate ID</button>
          </label>
          <label>
            <span>Recipient Name</span>
            <input
              type="text"
              id="recipient"
              placeholder="Nama penerima"
              required
            />
          </label>
          <label>
            <span>Certificate Type</span>
            <input
              type="text"
              id="cert-type"
              placeholder="Blockchain Fundamentals"
              required
            />
          </label>
          <label>
            <span>Issuer</span>
            <input
              type="text"
              id="issuer"
              value="Akim"
              required
            />
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn" id="submit-btn">
            Issue Certificate →
          </button>
        </div>
      </form>

      <div id="result-slot"></div>

    </div>
  </div>
</BaseLayout>

<style>
  .create-wrap { padding: var(--space-8) 0 var(--space-16); }

  .page-head {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }
  .back-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }
  .back-link:hover { color: var(--accent); }
  .page-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
  .page-head h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: var(--space-1);
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .page-sub {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .wallet-status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    font-size: 0.875rem;
  }
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.status-checking {
    background: var(--text-tertiary);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .status-dot.status-online { background: var(--positive); }
  .status-dot.status-offline { background: var(--negative); }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .wallet-status strong {
    color: var(--text-primary);
    display: block;
  }
  .wallet-status small {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 2px;
    font-family: var(--font-mono);
    word-break: break-all;
  }

  .create-form {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
  }

  .create-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .create-form label span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    font-weight: 600;
  }
  .create-form label small {
    font-size: 0.6875rem;
    color: var(--text-quaternary);
    margin-top: 2px;
  }

  .create-form input {
    background: var(--bg-base);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 0.625rem 0.875rem;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.15s ease;
  }
  .create-form input:focus {
    border-color: var(--accent);
  }
  .create-form input::placeholder {
    color: var(--text-quaternary);
  }
  .create-form input[readonly] {
    background: var(--bg-elevated);
    color: var(--text-secondary);
    cursor: not-allowed;
  }

  .btn-regen {
    margin-top: 6px;
    font-size: 11px;
    padding: 4px 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--text-secondary);
    font-family: inherit;
    align-self: flex-start;
  }
  .btn-regen:hover {
    background: var(--bg-base);
    border-color: var(--accent);
    color: var(--accent);
  }

  .form-actions {
    display: flex;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  #submit-btn {
    min-width: 200px;
  }
  #submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .result-box {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }
  .result-box.success {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-left: 3px solid var(--positive);
  }
  .result-box.error {
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-left: 3px solid var(--negative);
  }
  .result-box.info {
    background: rgba(79, 139, 255, 0.06);
    border: 1px solid rgba(79, 139, 255, 0.25);
    border-left: 3px solid var(--accent);
  }

  .result-box h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .result-box.success h3 { color: var(--positive); }
  .result-box.error h3 { color: var(--negative); }
  .result-box.info h3 { color: var(--accent); }

  .result-box p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .result-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
  }
  .result-details > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .result-details span:first-child {
    color: var(--text-tertiary);
  }
  .result-details span:last-child {
    font-family: var(--font-mono);
    color: var(--text-primary);
    word-break: break-all;
    text-align: right;
  }

  .result-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .form-grid { grid-template-columns: 1fr; }
    .page-head h1 { font-size: 1.5rem; }
  }
</style>

<script>
  import { BLOCKCHAIN_CONFIG, CERTIFICATE_ABI } from '../../../lib/blockchain';
  import { issueCertificate, hasMetaMask } from '../../../lib/writeContract';
  import { ethers } from 'ethers';

  // ============================================
  // AUTH GUARD
  // ============================================
  const wallet = localStorage.getItem('admin_wallet');
  if (!wallet) {
    window.location.href = '/admin/login';
  }

  const walletStatus = document.getElementById('wallet-status');
  const form = document.getElementById('create-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const resultSlot = document.getElementById('result-slot');

  // ============================================
  // AUTO-GENERATE CERTIFICATE ID
  // ============================================
  function generateCertificateId(): string {
    const year = new Date().getFullYear();
    // Tanpa I, O, 0, 1 — hindari kebingungan
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let random = '';
    for (let i = 0; i < 6; i++) {
      random += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return `CERT-${year}-${random}`;
  }

  const certIdInput = document.getElementById('cert-id') as HTMLInputElement;
  if (certIdInput) {
    certIdInput.value = generateCertificateId();
  }

  const regenBtn = document.getElementById('regenerate-id');
  if (regenBtn && certIdInput) {
    regenBtn.addEventListener('click', () => {
      certIdInput.value = generateCertificateId();
    });
  }

  // ============================================
  // CHECK WALLET STATUS
  // ============================================
  async function checkWallet() {
    if (!walletStatus) return;

    if (!hasMetaMask()) {
      walletStatus.innerHTML = `
        <div class="status-dot status-offline"></div>
        <div>
          <strong>MetaMask not installed</strong>
          <small>Install MetaMask to issue certificates.</small>
        </div>
      `;
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    try {
      const provider = new ethers.BrowserProvider((window as any).ethereum);
      const network = await provider.getNetwork();
      const signer = await provider.getSigner();
      const signerAddress = await signer.getAddress();

      // Cek network
      if (Number(network.chainId) !== BLOCKCHAIN_CONFIG.chainId) {
        walletStatus.innerHTML = `
          <div class="status-dot status-offline"></div>
          <div>
            <strong>Wrong network</strong>
            <small>Please switch MetaMask to Sepolia Testnet.</small>
          </div>
        `;
        if (submitBtn) submitBtn.disabled = true;
        return;
      }

      // Cek owner
      const readProvider = new ethers.JsonRpcProvider(BLOCKCHAIN_CONFIG.rpcUrl);
      const readContract = new ethers.Contract(
        BLOCKCHAIN_CONFIG.contractAddress,
        CERTIFICATE_ABI,
        readProvider
      );
      const owner = await readContract.getOwner();
      const isOwner = owner.toLowerCase() === signerAddress.toLowerCase();

      if (!isOwner) {
        walletStatus.innerHTML = `
          <div class="status-dot status-offline"></div>
          <div>
            <strong>Wallet not authorized</strong>
            <small>Only the contract owner can issue certificates.</small>
          </div>
        `;
        if (submitBtn) submitBtn.disabled = true;
        return;
      }

      walletStatus.innerHTML = `
        <div class="status-dot status-online"></div>
        <div>
          <strong>Wallet connected · Owner</strong>
          <small>${signerAddress}</small>
        </div>
      `;
      if (submitBtn) submitBtn.disabled = false;
    } catch (err) {
      walletStatus.innerHTML = `
        <div class="status-dot status-offline"></div>
        <div>
          <strong>Wallet not connected</strong>
          <small>Please connect MetaMask in the login page.</small>
        </div>
      `;
      if (submitBtn) submitBtn.disabled = true;
    }
  }

  // ============================================
  // HANDLE SUBMIT
  // ============================================
  async function handleSubmit(e: Event) {
    e.preventDefault();
    if (!resultSlot || !submitBtn) return;

    const certId = (document.getElementById('cert-id') as HTMLInputElement).value.trim();
    const recipient = (document.getElementById('recipient') as HTMLInputElement).value.trim();
    const certType = (document.getElementById('cert-type') as HTMLInputElement).value.trim();
    const issuer = (document.getElementById('issuer') as HTMLInputElement).value.trim();

    // Validasi
    if (!certId || !recipient || !certType || !issuer) {
      resultSlot.innerHTML = `
        <div class="result-box error">
          <h3>⚠ Form tidak lengkap</h3>
          <p>Isi semua field dulu.</p>
        </div>
      `;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Waiting for MetaMask...';

    resultSlot.innerHTML = `
      <div class="result-box info">
        <h3>⏳ Menunggu konfirmasi MetaMask</h3>
        <p>Konfirmasi transaksi di MetaMask untuk melanjutkan.</p>
      </div>
    `;

    try {
      const result = await issueCertificate(certId, recipient, certType, issuer);

      if (!result.success) {
        resultSlot.innerHTML = `
          <div class="result-box error">
            <h3>✗ Gagal issue certificate</h3>
            <p>${result.error}</p>
          </div>
        `;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Issue Certificate →';
        return;
      }

      // Success
      resultSlot.innerHTML = `
        <div class="result-box success">
          <h3>✓ Certificate Issued Successfully</h3>
          <p>Sertifikat berhasil terbit dan tercatat di Sepolia blockchain.</p>

          <div class="result-details">
            <div>
              <span>Certificate ID</span>
              <span>${result.certificateId}</span>
            </div>
            <div>
              <span>Recipient</span>
              <span>${recipient}</span>
            </div>
            <div>
              <span>Type</span>
              <span>${certType}</span>
            </div>
            <div>
              <span>Network</span>
              <span>${BLOCKCHAIN_CONFIG.network}</span>
            </div>
            <div>
              <span>Tx Hash</span>
              <span>${result.txHash}</span>
            </div>
            <div>
              <span>Block</span>
              <span>#${result.blockNumber}</span>
            </div>
          </div>

          <div class="result-actions">
            <a href="/certificate/verify?id=${result.certificateId}" class="btn" target="_blank">
              Verify Certificate →
            </a>
            <a href="https://sepolia.etherscan.io/tx/${result.txHash}" class="btn-secondary" target="_blank" rel="noopener">
              View on Etherscan
            </a>
            <a href="/admin" class="btn-secondary">
              Back to Dashboard
            </a>
          </div>
        </div>
      `;

      // Reset form + generate ID baru
      form.reset();
      (document.getElementById('issuer') as HTMLInputElement).value = 'Akim';
      if (certIdInput) certIdInput.value = generateCertificateId();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Issue Certificate →';

    } catch (err: any) {
      resultSlot.innerHTML = `
        <div class="result-box error">
          <h3>✗ Error</h3>
          <p>${err.message || 'Unknown error.'}</p>
        </div>
      `;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Issue Certificate →';
    }
  }

  // Init
  checkWallet();
  if (form) form.addEventListener('submit', handleSubmit);

  // Listen network/wallet change
  if (hasMetaMask()) {
    (window as any).ethereum.on('chainChanged', () => window.location.reload());
    (window as any).ethereum.on('accountsChanged', () => window.location.reload());
  }
</script>