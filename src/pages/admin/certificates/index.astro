---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="All Certificates — Akim Certificate" description="Manage all digital certificates issued on Sepolia.">
  <div class="certs-wrap">
    <div class="container">

      <header class="page-head">
        <div>
          <a href="/admin" class="back-link">← Dashboard</a>
          <p class="page-label">Admin</p>
          <h1>All Certificates</h1>
          <p class="page-sub">
            Manage all digital certificates issued on Sepolia Testnet.
          </p>
        </div>
        <a href="/admin/certificates/create" class="btn">Create Certificate →</a>
      </header>

      <section class="controls">
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="Search certificate..."
          autocomplete="off"
        />
        <select id="filter-select" class="filter-select">
          <option value="all">All</option>
          <option value="valid">Valid</option>
          <option value="revoked">Revoked</option>
        </select>
        <select id="sort-select" class="filter-select">
          <option value="newest">Newest</option>
          <option value="oldest">Oldest</option>
        </select>
      </section>

      <div id="certs-container">
        <div class="loading-state">
          <div class="spinner"></div>
          <p>Loading certificates from blockchain...</p>
        </div>
      </div>

      <div class="list-footer" id="list-footer" hidden>
        <span id="list-count">—</span>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .certs-wrap { padding: var(--space-8) 0 var(--space-16); }

  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }
  .back-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }
  .back-link:hover { color: var(--accent); }
  .page-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
  .page-head h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: var(--space-1);
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .page-sub {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .controls {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 240px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.625rem 0.875rem;
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.15s ease;
  }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--text-quaternary); }

  .filter-select {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.625rem 0.875rem;
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--text-primary);
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .filter-select:focus { border-color: var(--accent); }

  .loading-state {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-12) 0;
    color: var(--text-tertiary);
    font-size: 0.875rem;
    justify-content: center;
  }
  .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-subtle);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .empty-state {
    padding: var(--space-12) 0;
    text-align: center;
    color: var(--text-tertiary);
  }
  .empty-state strong {
    display: block;
    color: var(--text-primary);
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }
  .empty-state p {
    font-size: 0.875rem;
    margin-bottom: var(--space-4);
  }

  .cert-table {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .cert-header {
    display: grid;
    grid-template-columns: 2fr 2fr 2fr 1fr;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
  }

  .cert-row {
    display: grid;
    grid-template-columns: 2fr 2fr 2fr 1fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.875rem;
    align-items: center;
    transition: background 0.15s ease;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .cert-row:last-child { border-bottom: none; }
  .cert-row:hover { background: var(--bg-surface); }
  .cert-row:hover .cert-id { color: var(--accent); }

  .cert-id {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.8125rem;
    transition: color 0.15s ease;
  }
  .cert-name { color: var(--text-secondary); }
  .cert-type { color: var(--text-tertiary); font-size: 0.8125rem; }

  .cert-status {
    font-size: 0.6875rem;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    justify-self: start;
  }
  .cert-status.valid {
    background: rgba(16, 185, 129, 0.1);
    color: var(--positive);
  }
  .cert-status.revoked {
    background: rgba(239, 68, 68, 0.1);
    color: var(--negative);
  }

  .list-footer {
    padding: var(--space-4) 0;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-align: center;
  }

  @media (max-width: 900px) {
    .cert-header {
      grid-template-columns: 1fr 1fr;
    }
    .cert-header > div:nth-child(3),
    .cert-header > div:nth-child(4) {
      display: none;
    }
    .cert-row {
      grid-template-columns: 1fr 1fr;
    }
    .cert-row > span:nth-child(3),
    .cert-row > span:nth-child(4) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .page-head { flex-direction: column; align-items: stretch; }
    .page-head h1 { font-size: 1.5rem; }
    .controls { flex-direction: column; }
    .search-input { min-width: 0; }
  }
</style>

<script>
  import { BLOCKCHAIN_CONFIG, getProvider, CERTIFICATE_ABI } from '../../../lib/blockchain';
  import { ethers } from 'ethers';

  // Auth guard
  const wallet = localStorage.getItem('admin_wallet');
  if (!wallet) {
    window.location.href = '/admin/login';
  }

  const DEPLOY_BLOCK = 11728000;

  interface CertItem {
    certId: string;
    recipient: string;
    type: string;
    issuedAt: number;
    txHash: string;
    blockNumber: number;
  }

  let allCerts: CertItem[] = [];

  // ============================================
  // QUERY EVENTS
  // ============================================
  async function queryAllEvents(contract: any, filter: any) {
    const provider = contract.runner?.provider;
    if (!provider) return [];

    const latest = await provider.getBlockNumber();
    const CHUNK = 9999;
    const allEvents: any[] = [];

    for (let from = DEPLOY_BLOCK; from <= latest; from += CHUNK) {
      const to = Math.min(from + CHUNK - 1, latest);
      try {
        const events = await contract.queryFilter(filter, from, to);
        allEvents.push(...events);
      } catch (e) {
        // skip
      }
    }
    return allEvents;
  }

  // ============================================
  // DECODE CERT ID
  // ============================================
  async function decodeCertId(provider: any, txHash: string): Promise<string> {
    try {
      const tx = await provider.getTransaction(txHash);
      if (!tx || !tx.data) return '—';
      const iface = new ethers.Interface(CERTIFICATE_ABI);
      const decoded = iface.parseTransaction({ data: tx.data });
      if (decoded?.args?.[0]) return decoded.args[0];
      return '—';
    } catch {
      return '—';
    }
  }

  // ============================================
  // LOAD ALL CERTIFICATES
  // ============================================
  async function loadAll() {
    const container = document.getElementById('certs-container');
    if (!container) return;

    try {
      const provider = getProvider();
      const contract = new ethers.Contract(
        BLOCKCHAIN_CONFIG.contractAddress,
        CERTIFICATE_ABI,
        provider
      );

      const filter = contract.filters.CertificateIssued();
      const events = await queryAllEvents(contract, filter);

      allCerts = [];
      for (const ev of events) {
        const args = ev.args;
        const recipient = args[1];
        const type = args[2];
        const issuedAt = Number(args[3]);
        const certId = await decodeCertId(provider, ev.transactionHash);

        allCerts.push({
          certId,
          recipient,
          type,
          issuedAt,
          txHash: ev.transactionHash,
          blockNumber: ev.blockNumber,
        });
      }

      renderList();
    } catch (err: any) {
      container.innerHTML = `
        <div class="empty-state">
          <strong>Unable to load certificates</strong>
          <p>${err.message || 'Please check your connection to Sepolia.'}</p>
          <button class="btn-secondary" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  // ============================================
  // RENDER LIST
  // ============================================
  function renderList() {
    const container = document.getElementById('certs-container');
    const footer = document.getElementById('list-footer');
    const countEl = document.getElementById('list-count');
    if (!container) return;

    const searchEl = document.getElementById('search-input') as HTMLInputElement;
    const filterEl = document.getElementById('filter-select') as HTMLSelectElement;
    const sortEl = document.getElementById('sort-select') as HTMLSelectElement;

    const search = (searchEl?.value || '').toLowerCase().trim();
    const filter = filterEl?.value || 'all';
    const sort = sortEl?.value || 'newest';

    let filtered = allCerts.filter((c) => {
      if (search) {
        const match =
          c.certId.toLowerCase().includes(search) ||
          c.recipient.toLowerCase().includes(search) ||
          c.type.toLowerCase().includes(search);
        if (!match) return false;
      }
      if (filter === 'revoked') return false;
      return true;
    });

    filtered = filtered.sort((a, b) => {
      if (sort === 'newest') return b.issuedAt - a.issuedAt;
      return a.issuedAt - b.issuedAt;
    });

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="empty-state">
          <strong>No certificate found</strong>
          <p>Coba ubah filter atau search keyword.</p>
        </div>
      `;
      if (footer) footer.hidden = true;
      return;
    }

    let html = '<div class="cert-table">';
    html += `
      <div class="cert-header">
        <div>Certificate ID</div>
        <div>Recipient</div>
        <div>Type</div>
        <div>Status</div>
      </div>
    `;

    for (const c of filtered) {
      const detailUrl = `/admin/certificates/detail?id=${encodeURIComponent(c.certId)}`;
      html += `
        <a href="${detailUrl}" class="cert-row">
          <span class="cert-id">${c.certId}</span>
          <span class="cert-name">${c.recipient}</span>
          <span class="cert-type">${c.type}</span>
          <span class="cert-status valid">VALID</span>
        </a>
      `;
    }
    html += '</div>';

    container.innerHTML = html;

    if (footer && countEl) {
      footer.hidden = false;
      countEl.textContent = `Showing ${filtered.length} of ${allCerts.length} certificate${allCerts.length !== 1 ? 's' : ''}`;
    }
  }

  // ============================================
  // EVENT LISTENERS
  // ============================================
  const searchEl = document.getElementById('search-input');
  const filterEl = document.getElementById('filter-select');
  const sortEl = document.getElementById('sort-select');

  searchEl?.addEventListener('input', renderList);
  filterEl?.addEventListener('change', renderList);
  sortEl?.addEventListener('change', renderList);

  // Init
  loadAll();
</script>