---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Verify Certificate — Akim" description="Verifikasi sertifikat digital berbasis blockchain Sepolia.">
  <div class="container">
    <header class="page-header">
      <a href="/certificate" class="back-link">← Certificate</a>
      <p class="page-label">Verification</p>
      <h1>Verifikasi Sertifikat</h1>
    </header>

    <form class="verify-form" id="verify-form">
      <label>
        <span>Certificate ID</span>
        <input type="text" id="certificate-id" placeholder="CERT-2026-001" autocomplete="off" spellcheck="false" required />
      </label>
      <button type="submit" class="btn">Verifikasi →</button>
    </form>

    <p class="hint">Contoh ID: <code>CERT-2026-001</code></p>

    <div id="verify-result" style="margin-top: 3rem;"></div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
    max-width: 640px;
  }
  .back-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }
  .back-link:hover { color: var(--accent); }
  .page-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }
  .page-header h1 { font-size: 2.25rem; margin: 0; }

  .verify-form {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .verify-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .verify-form label span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
  }
  .verify-form input {
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.15s ease;
  }
  .verify-form input:focus { border-color: var(--accent); }
  .verify-form button { align-self: flex-start; }
  .hint { font-size: 0.8125rem; color: var(--text-tertiary); }
  .hint code {
    background: var(--bg-elevated);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .loading {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) 0;
    color: var(--text-tertiary);
  }
  .loading-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 1.5s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.8); }
  }

  .result-card {
    max-width: 640px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .result-card.valid { border-left: 3px solid var(--positive); }
  .result-card.revoked { border-left: 3px solid var(--warning); }

  .result-status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .result-status-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }
  .result-card.valid .result-status-icon {
    background: rgba(16, 185, 129, 0.15);
    color: var(--positive);
  }
  .result-card.revoked .result-status-icon {
    background: rgba(245, 158, 11, 0.15);
    color: var(--warning);
  }
  .result-status-text h2 {
    font-size: 1.125rem;
    margin: 0 0 2px 0;
    color: var(--text-primary);
  }
  .result-status-text p {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0;
  }
  .result-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-6);
  }
  .result-item { display: flex; flex-direction: column; gap: 2px; }
  .result-item.full { grid-column: 1 / -1; }
  .result-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
  }
  .result-value {
    font-size: 0.9375rem;
    color: var(--text-primary);
    word-break: break-all;
  }
  .result-value.mono {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* QR Section */
  .qr-section {
    max-width: 640px;
    margin-top: var(--space-6);
    padding: var(--space-6);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }
  .qr-section-title {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }
  .qr-flex {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .qr-image-wrap {
    background: white;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .qr-image-wrap canvas,
  .qr-image-wrap img { display: block; }
  .qr-info { flex: 1; min-width: 220px; }
  .qr-url {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    word-break: break-all;
    line-height: 1.6;
  }
  .qr-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .error-box {
    max-width: 640px;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-left: 3px solid var(--negative);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }
  .error-box p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .error-box strong { color: var(--negative); }

  @media (max-width: 640px) {
    .page-header h1 { font-size: 1.75rem; }
    .result-grid { grid-template-columns: 1fr; }
    .qr-flex { flex-direction: column; align-items: center; }
  }
</style>

<script>
  import { verifyCertificate, formatDate, BLOCKCHAIN_CONFIG } from '../../lib/blockchain';
  import QRCode from 'qrcode';

  const form = document.getElementById('verify-form');
  const input = document.getElementById('certificate-id');
  const resultEl = document.getElementById('verify-result');

  function escape(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function runVerify(certificateId) {
    if (!resultEl || !certificateId) return;

    resultEl.innerHTML = `
      <div class="loading">
        <div class="loading-dot"></div>
        <p>Baca data dari blockchain...</p>
      </div>
    `;

    const result = await verifyCertificate(certificateId);

    if (!result.success || !result.data) {
      resultEl.innerHTML = `
        <div class="error-box">
          <p><strong>⚠️ Tidak ditemukan.</strong></p>
          <p>${escape(result.error || 'Certificate tidak ditemukan di blockchain.')}</p>
          <p style="margin-top: 8px; font-size: 0.875rem;">
            Pastikan Hardhat Local Network sedang berjalan, dan Certificate ID yang dimasukkan benar.
          </p>
        </div>
      `;
      return;
    }

    const d = result.data;
    const statusClass = d.revoked ? 'revoked' : 'valid';
    const statusIcon = d.revoked ? '!' : '✓';
    const statusTitle = d.revoked ? 'Certificate Revoked' : 'Certificate Verified';
    const statusDesc = d.revoked
      ? 'Certificate ini sudah dicabut oleh issuer.'
      : 'Data sertifikat valid dan tercatat di blockchain.';

    const verifyUrl = `https://certificate.akim.web.id/certificate/verify?id=${d.certificateId}`;

    resultEl.innerHTML = `
      <div class="result-card ${statusClass}">
        <div class="result-status">
          <div class="result-status-icon">${statusIcon}</div>
          <div class="result-status-text">
            <h2>${statusTitle}</h2>
            <p>${statusDesc}</p>
          </div>
        </div>
        <div class="result-grid">
          <div class="result-item">
            <span class="result-label">Certificate ID</span>
            <span class="result-value mono">${escape(d.certificateId)}</span>
          </div>
          <div class="result-item">
            <span class="result-label">Recipient</span>
            <span class="result-value">${escape(d.recipientName)}</span>
          </div>
          <div class="result-item">
            <span class="result-label">Certificate Type</span>
            <span class="result-value">${escape(d.certificateType)}</span>
          </div>
          <div class="result-item">
            <span class="result-label">Issuer</span>
            <span class="result-value">${escape(d.issuer)}</span>
          </div>
          <div class="result-item">
            <span class="result-label">Issued At</span>
            <span class="result-value">${formatDate(d.issuedAt)}</span>
          </div>
          <div class="result-item">
            <span class="result-label">Status</span>
            <span class="result-value">${d.revoked ? 'Revoked' : 'Valid'}</span>
          </div>
          <div class="result-item full">
            <span class="result-label">Certificate Hash</span>
            <span class="result-value mono">${escape(d.certificateHash)}</span>
          </div>
          <div class="result-item full">
            <span class="result-label">Contract Address</span>
            <span class="result-value mono">${escape(BLOCKCHAIN_CONFIG.contractAddress)}</span>
          </div>
          <div class="result-item full">
            <span class="result-label">Blockchain Network</span>
            <span class="result-value mono">${escape(BLOCKCHAIN_CONFIG.network)}</span>
          </div>
        </div>
      </div>

      <div class="qr-section">
        <div class="qr-section-title">Share Certificate</div>
        <div class="qr-flex">
          <div class="qr-image-wrap">
            <canvas id="qr-canvas"></canvas>
          </div>
          <div class="qr-info">
            <div class="qr-url">${escape(verifyUrl)}</div>
            <div class="qr-actions">
              <button class="btn-secondary" id="download-qr-btn">Download QR</button>
              <button class="btn-secondary" id="copy-url-btn">Copy URL</button>
            </div>
          </div>
        </div>
      </div>
    `;

    // Generate QR
    await generateQR(verifyUrl);
  }

  async function generateQR(text) {
    const canvas = document.getElementById('qr-canvas');
    if (!canvas) return;

    try {
      await QRCode.toCanvas(canvas, text, {
        width: 180,
        margin: 2,
        color: { dark: '#000000', light: '#ffffff' },
      });
    } catch (e) {
      console.warn('QR generation failed:', e);
    }

    // Download button
    const downloadBtn = document.getElementById('download-qr-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        const url = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = url;
        const id = new URLSearchParams(window.location.search).get('id') || 'certificate';
        a.download = `${id}-qr.png`;
        a.click();
      });
    }

    // Copy URL button
    const copyBtn = document.getElementById('copy-url-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.textContent = '✓ Copied';
          setTimeout(() => { copyBtn.textContent = 'Copy URL'; }, 2000);
        } catch (e) {
          console.warn('Copy failed:', e);
        }
      });
    }
  }

  // Cek URL query string saat load
  const params = new URLSearchParams(window.location.search);
  const initialId = params.get('id');
  if (initialId) {
    if (input) input.value = initialId;
    runVerify(initialId);
  }

  // Handle form submit
  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = input.value.trim();
      if (!id) return;
      const url = new URL(window.location.href);
      url.searchParams.set('id', id);
      window.history.pushState({}, '', url);
      runVerify(id);
    });
  }
</script>