---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOCKCHAIN_CONFIG } from '../../lib/blockchain';
---

<BaseLayout title="Digital Certificate — Akim" description="Sistem sertifikat digital berbasis blockchain Sepolia testnet.">
  <div class="container">
    <header class="page-header">
      <p class="page-label">Certificate</p>
      <h1>Digital Certificate</h1>
      <p class="page-lead">
        Sistem penerbitan dan verifikasi sertifikat digital berbasis blockchain
        dan smart contract.
      </p>
    </header>

    <section class="intro">
      <p>
        Gue bikin sistem ini sambil belajar gimana blockchain bisa dipakai buat
        nyimpen dan verifikasi sertifikat digital. Setiap sertifikat punya ID
        unik yang tercatat di smart contract, dan bisa diverifikasi siapa aja.
      </p>
      <p>
        Sistem ini jalan di <strong>Sepolia Testnet</strong> — jaringan pengujian
        publik Ethereum. Bukan mainnet, tapi data di sini <strong>permanen</strong>
        dan bisa diliat siapa aja di Etherscan.
      </p>
    </section>

    <section class="warning-box">
      <p>
        <strong>ℹ️ Testnet Mode.</strong>
        Sistem ini berjalan di Sepolia Testnet — jaringan uji publik untuk
        development. Data tersimpan permanen di blockchain Sepolia, tapi ini
        <strong>bukan mainnet</strong>. Jangan digunakan untuk sertifikat produksi
        tanpa audit.
      </p>
    </section>

    <section class="actions">
      <a href="/certificate/verify" class="btn">Verifikasi Sertifikat →</a>
    </section>

    <section class="info-grid">
      <div class="info-block">
        <span class="info-label">Network</span>
        <span class="info-value mono">{BLOCKCHAIN_CONFIG.network}</span>
      </div>
      <div class="info-block">
        <span class="info-label">RPC URL</span>
        <span class="info-value mono">{BLOCKCHAIN_CONFIG.rpcUrl}</span>
      </div>
      <div class="info-block">
        <span class="info-label">Chain ID</span>
        <span class="info-value mono">{BLOCKCHAIN_CONFIG.chainId}</span>
      </div>
      <div class="info-block">
        <span class="info-label">Contract Address</span>
        <span class="info-value mono small">{BLOCKCHAIN_CONFIG.contractAddress}</span>
      </div>
    </section>

    <p class="etherscan-link">
      Lihat contract di <a
        href={`https://sepolia.etherscan.io/address/${BLOCKCHAIN_CONFIG.contractAddress}`}
        target="_blank"
        rel="noopener"
      >Sepolia Etherscan →</a>
    </p>

    <section class="status" id="blockchain-status">
      <div class="status-dot status-checking"></div>
      <div class="status-text">
        <strong>Cek status blockchain...</strong>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
    max-width: 640px;
  }
  .page-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }
  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }
  .page-lead {
    font-size: 1.0625rem;
    color: var(--text-tertiary);
    margin: 0;
    line-height: 1.7;
  }

  .intro {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }
  .intro p {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }
  .intro strong {
    color: var(--text-primary);
  }

  .warning-box {
    max-width: 640px;
    background: rgba(79, 139, 255, 0.06);
    border: 1px solid rgba(79, 139, 255, 0.2);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-8);
  }
  .warning-box p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .warning-box strong {
    color: var(--accent);
  }

  .actions {
    margin-bottom: var(--space-12);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    max-width: 640px;
    margin-bottom: var(--space-4);
  }
  .info-block {
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .info-label {
    display: block;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-2);
    font-weight: 600;
  }
  .info-value {
    display: block;
    font-size: 0.875rem;
    color: var(--text-primary);
    word-break: break-all;
  }
  .info-value.mono {
    font-family: var(--font-mono);
  }
  .info-value.small {
    font-size: 0.75rem;
  }

  .etherscan-link {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-8);
    max-width: 640px;
  }
  .etherscan-link a {
    color: var(--accent);
  }
  .etherscan-link a:hover {
    color: var(--accent-hover);
  }

  .status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    max-width: 640px;
  }
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.status-checking {
    background: var(--text-tertiary);
    animation: pulse 1.5s ease-in-out infinite;
  }
  .status-dot.status-online {
    background: var(--positive);
  }
  .status-dot.status-offline {
    background: var(--negative);
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .status-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .status-text strong {
    color: var(--text-primary);
  }
  .status-text small {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 2px;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .page-header h1 { font-size: 1.75rem; }
    .info-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { getBlockchainStatus } from '../../lib/blockchain';

  async function checkStatus() {
    const statusEl = document.getElementById('blockchain-status');
    if (!statusEl) return;

    const status = await getBlockchainStatus();

    if (status.connected) {
      statusEl.innerHTML = `
        <div class="status-dot status-online"></div>
        <div class="status-text">
          <strong>Blockchain Connected</strong>
          <small>Network: ${status.network} · Block #${status.blockNumber}</small>
        </div>
      `;
    } else {
      statusEl.innerHTML = `
        <div class="status-dot status-offline"></div>
        <div class="status-text">
          <strong>Blockchain Offline</strong>
          <small>Ga bisa connect ke RPC. Cek koneksi internet atau endpoint.</small>
        </div>
      `;
    }
  }

  checkStatus();
  setInterval(checkStatus, 15000);
</script>