---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { socials } from '../data/socials';
---

<BaseLayout title="About — Akim" description="Kenalin, gue Akim. Mahasiswa Informatika yang suka ngulik code, crypto, dan Web3.">
  <div class="container">

    <!-- HERO -->
    <header class="hero reveal">
      <p class="hero-label">About Me</p>
      <h1>Kenalin, gue <span class="accent">Akim</span>.</h1>
      <p class="hero-sub">
        Mahasiswa Informatika yang suka ngulik code, crypto, blockchain, Web3, dan trading.
      </p>
    </header>

    <!-- INTRO + VISUAL -->
    <section class="intro reveal">
      <div class="intro-text">
        <h2>Sedikit tentang gue.</h2>
        <p>
          Gue Akim, mahasiswa Informatika yang masih terus belajar dan suka bikin
          berbagai project karena penasaran gimana sesuatu bekerja.
        </p>
        <p>
          Dari coding, blockchain, sampai trading, gue lebih suka belajar langsung
          dengan mencoba dan membangun sesuatu.
        </p>
      </div>

      <aside class="intro-visual" aria-hidden="true">
        <div class="terminal">
          <div class="terminal-bar">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
            <span class="terminal-title">akim@web:~</span>
          </div>
          <div class="terminal-body">
            <div><span class="prompt">$</span> whoami</div>
            <div class="output">akim — informatics student</div>
            <div><span class="prompt">$</span> cat interests.txt</div>
            <div class="output">coding, crypto, blockchain, web3</div>
            <div><span class="prompt">$</span> uptime</div>
            <div class="output">learning since 2020</div>
            <div><span class="prompt">$</span> <span class="cursor">_</span></div>
          </div>
        </div>
      </aside>
    </section>

    <!-- KENAPA SUKA NGULIK -->
    <section class="why reveal">
      <h2>Kenapa gue suka ngulik?</h2>
      <p>
        Kadang gue bikin sesuatu bukan karena ada tugas atau kebutuhan tertentu,
        tapi cuma karena penasaran: <em>sebenarnya cara kerjanya gimana?</em>
      </p>
      <p>
        Rasa penasaran itu yang akhirnya membawa gue dari coding ke berbagai hal
        seperti blockchain, Web3, crypto, dan trading. Kadang berhasil, kadang
        stuck berjam-jam. Tapi ya, itu bagian dari belajarnya. 😅
      </p>
    </section>

    <!-- TIMELINE -->
    <section class="timeline-section reveal">
      <h2>Perjalanan singkat</h2>
      <ol class="timeline">
        <li class="timeline-item">
          <div class="timeline-year">2020</div>
          <div class="timeline-content">
            <p>Mulai tertarik dan belajar tentang crypto.</p>
          </div>
        </li>
        <li class="timeline-item timeline-item-now">
          <div class="timeline-year">Sekarang</div>
          <div class="timeline-content">
            <p>Terus belajar Informatika, programming, blockchain, Web3, dan trading.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- INTERESTS -->
    <section class="interests reveal">
      <h2>Yang lagi gue pelajari</h2>
      <ul class="tags">
        {profile.interests.map((interest) => (
          <li class="tag">{interest}</li>
        ))}
      </ul>
    </section>

    <!-- EDUCATION -->
    <section class="education reveal">
      <h2>Education</h2>
      <div class="edu-card">
        <p class="edu-role">{profile.education}</p>
        <p class="edu-note">Masih belajar. Masih banyak yang belum tahu.</p>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact reveal">
      <h2>Kontak</h2>
      <p class="contact-intro">
        Kalau mau ngobrol soal project, teknologi, atau sekadar tukar ide,
        boleh kontak gue di salah satu ini:
      </p>
      <ul class="contact-list">
        <li>
          <span class="contact-label">Email</span>
          <a href={`mailto:${socials.email}`}>{socials.email}</a>
        </li>
        <li>
          <span class="contact-label">Instagram</span>
          <a href={socials.instagram.url} target="_blank" rel="noopener">@{socials.instagram.handle}</a>
        </li>
        <li>
          <span class="contact-label">Telegram</span>
          <a href={socials.telegram.url} target="_blank" rel="noopener">@{socials.telegram.handle}</a>
        </li>
        <li>
          <span class="contact-label">GitHub</span>
          <a href={socials.github.url} target="_blank" rel="noopener">{socials.github.username}</a>
        </li>
      </ul>
    </section>

  </div>
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero {
    padding: var(--space-8) 0 var(--space-16);
    max-width: 720px;
  }
  .hero-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }
  .hero h1 {
    font-size: 3rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
    font-weight: 700;
  }
  .hero .accent { color: var(--accent); }
  .hero-sub {
    font-size: 1.125rem;
    color: var(--text-tertiary);
    line-height: 1.7;
    margin: 0;
    max-width: 560px;
  }

  /* ============ INTRO + VISUAL ============ */
  .intro {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-12) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .intro h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 var(--space-6) 0;
  }
  .intro-text p {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }
  .intro-text p:last-child { margin-bottom: 0; }

  .terminal {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: var(--shadow-md);
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.75rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }
  .terminal-title {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--text-quaternary);
  }
  .terminal-body {
    padding: var(--space-4);
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .prompt { color: var(--accent); margin-right: 0.4rem; }
  .output { color: var(--text-tertiary); padding-left: 1rem; }
  .cursor {
    animation: blink 1s step-end infinite;
    color: var(--text-primary);
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* ============ WHY ============ */
  .why {
    padding: var(--space-12) 0;
    max-width: 640px;
  }
  .why h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 var(--space-6) 0;
  }
  .why p {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }
  .why em {
    color: var(--text-primary);
    font-style: italic;
  }

  /* ============ TIMELINE ============ */
  .timeline-section {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .timeline-section h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 var(--space-8) 0;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--border-subtle);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-6);
    padding-left: var(--space-8);
    padding-bottom: var(--space-8);
    position: relative;
  }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 2px solid var(--border-strong);
  }
  .timeline-item-now::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .timeline-year {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }
  .timeline-item-now .timeline-year { color: var(--accent); }
  .timeline-content p {
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.7;
  }

  /* ============ INTERESTS ============ */
  .interests {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .interests h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 var(--space-6) 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }
  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  /* ============ EDUCATION ============ */
  .education {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .education h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 var(--space-6) 0;
  }
  .edu-card {
    padding: var(--space-6);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
  }
  .edu-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 var(--space-1) 0;
  }
  .edu-note {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  /* ============ CONTACT ============ */
  .contact {
    padding: var(--space-12) 0 var(--space-16);
    border-top: 1px solid var(--border-subtle);
  }
  .contact h2 {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 0 0 var(--space-4) 0;
  }
  .contact-intro {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    max-width: 560px;
    line-height: 1.7;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 560px;
  }
  .contact-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9375rem;
  }
  .contact-list li:last-child { border-bottom: none; }
  .contact-label {
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ============ REVEAL ============ */
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 768px) {
    .intro {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero h1 { font-size: 2.25rem; }
    .hero-sub { font-size: 1rem; }
    .timeline-item {
      grid-template-columns: 90px 1fr;
      gap: var(--space-4);
    }
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 1.875rem; }
    .contact-list li {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .timeline-year { font-size: 0.75rem; }
  }
</style>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }
</script>